# internal-sage-processor / _shared/sageone-client.ts configuration
#
# Placeholders only. Never commit real values here or anywhere else in
# the repository. In Supabase, set the real values as Edge Function
# secrets (`supabase secrets set ...`), not in a committed .env file.
#
# SAGEONE_ENABLED must be the literal string "true" to allow any live
# Sage request. It defaults to disabled. Do not set it to "true" outside
# a controlled sandbox test — see ../_shared/sageone-client.ts and
# ./SAGE_API_RESEARCH.md.
SAGEONE_ENABLED=false

# Base URL for Sage Business Cloud Accounting South Africa. Confirmed
# production value is https://accounting.sageone.co.za — use a sandbox
# company's URL for testing if Sage provides one, otherwise this same
# host with a sandbox company id.
SAGEONE_API_URL=https://accounting.sageone.co.za

# Issued by Sage per developer/company registration. Required on every
# request as the `apikey` query parameter.
SAGEONE_API_KEY=YOUR_SAGE_API_KEY

# A dedicated Sage user's login used for HTTP Basic auth. Do NOT reuse a
# real accountant's personal login for an automated integration.
SAGEONE_USERNAME=YOUR_SAGE_API_USERNAME
SAGEONE_PASSWORD=YOUR_SAGE_API_PASSWORD

# The target Sage company id, required as the `companyid` query
# parameter on every company-scoped call.
SAGEONE_COMPANY_ID=YOUR_SAGE_COMPANY_ID

# Integer ID of the TaxType record in THIS Sage company that represents
# standard 15% VAT. This is company-specific and cannot be guessed —
# use the client's getTaxTypes() (TaxType/Get) against a sandbox company
# first to find the real value. Do not fill this in from assumption.
SAGEONE_TAX_TYPE_ID=YOUR_SAGE_STANDARD_VAT_TAX_TYPE_ID
