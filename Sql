-- Performance fix for the Email History admin page.
--
-- The page's list query was doing `select("*")` against email_queue with no
-- limit, which drags down html_content (the full rendered email body,
-- unbounded text) for every row on every load/poll. The app-side fix caps
-- the list query and excludes html_content from it; this migration backs
-- that up with indexes for the filters/counts the page now runs
-- server-side, so those queries stay index-scans instead of seq-scans as
-- the table grows.
--
-- idx_email_queue_created_at (created_at DESC) and idx_email_queue_status
-- already exist from the original table migration and cover the base list
-- ordering and status tab. is_read and forwarded_to did not have indexes,
-- even though the "Unattended"/"Forwarded" tabs and the new exact-count
-- stat queries filter on them.

CREATE INDEX IF NOT EXISTS idx_email_queue_is_read
  ON public.email_queue (is_read);

CREATE INDEX IF NOT EXISTS idx_email_queue_forwarded_to
  ON public.email_queue (forwarded_to)
  WHERE forwarded_to IS NOT NULL;
